# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=123456789

# Database (Default is SQLite, can be postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=sqlite+aiosqlite:///./blupal.db

# Server Config
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
BASE_URL=http://localhost:8000

# Fernet Key for AES Session Encryption (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=dGhpc2lzYXRlc3RrZXlmaWxsM3JkZGV2ZWxvcG1lbnQxMg==

# Business & Commission Settings
DEFAULT_FEE_PERCENT=2.0
DEFAULT_FEE_CAP=350000
FREE_TRIAL_DAYS=30
FREE_TRIAL_TRANSACTIONS=50
MIN_WALLET_BALANCE_ALERT=500000

# Polling & Invoices
INVOICE_TTL_MINUTES=20
POLL_INTERVAL_SECONDS=10
WEBHOOK_TIMEOUT_SECONDS=10
